# Copy to backend/.env (or export as environment variables). All keys are prefixed MDI_.

# Where originals, page renders and the SQLite index live (default: <repo>/data)
# MDI_DATA_DIR=/var/lib/mdi

# AI reasoning layer (optional). Without a key the app runs in extractive mode:
# search, extraction, calculators and cited passages still work; interpretation does not.
# MDI_ANTHROPIC_API_KEY=sk-ant-...
# MDI_AI_MODEL=claude-opus-5

# Optional hosted embeddings for semantic search (local TF-IDF is used when unset)
# MDI_VOYAGE_API_KEY=pa-...

# OCR
# MDI_OCR_ENGINE=auto          # auto (RapidOCR + Tesseract read every scanned page) | rapid | tesseract | none
# MDI_OCR_RETRY_BELOW=0.80     # Tesseract re-reads a page in black-and-white below this mean confidence
# MDI_VERIFY=true              # check every scanned value against the second reader; disputed values are left blank
# MDI_VERIFY_AI=true           # with an Anthropic key, show remaining blanks to the model (nothing is sent without a key)
# MDI_AI_VERIFY_MAX_PAGES=60
# MDI_AUTO_EXPORT=true         # write <data dir>/exports/<name>/ for every processed document
# MDI_OCR_LANGUAGES=eng        # e.g. eng+deu (install the tesseract language packs)
# MDI_OCR_DPI=300
# MDI_RENDER_DPI=150

# Quality control: OCR word confidence below this flags a critical value for verification
# MDI_LOW_CONFIDENCE_THRESHOLD=0.80

# Processing
# MDI_INGEST_WORKERS=2
# MDI_MAX_UPLOAD_MB=200

# Phone access (desktop app): serve the UI on the local network so a phone on
# the same Wi-Fi can open it. The launcher generates the pairing key into
# <data dir>/phone-key.txt; without a key the API is open (dev server, Docker).
# MDI_LAN=true
# MDI_ACCESS_KEY=
